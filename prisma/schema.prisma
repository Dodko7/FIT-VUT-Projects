// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = "file:./db.sqlite"
}

// LUDO MODELS

// Game model
model Game {
    id        Int       @id @default(autoincrement())
    name      String   @unique
    lastPlayed DateTime
    players   Player[]
    over      Boolean   @default(false)
    // This can be used as a turn tracker
    turn Color  @default(RED)
    // So that if a player throws a 6, we know they can play again
    extraTurn Boolean @default(false)
}

// Player model
model Player {
    id        Int       @id @default(autoincrement())
    name      String
    color     Color
    game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
    gameId    Int
    pawns     Pawn[]
    isBot     Boolean
    finished  Boolean   @default(false)
}

// Pawn model
model Pawn {
    id        Int       @id @default(autoincrement())
    position  Int
    player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
    playerId  Int
    gameId    Int
    inHome     Boolean   @default(false)
    // Convenient
    color     Color
}

// Color enum
enum Color {
    RED
    BLUE
    GREEN
    YELLOW
}

// END OF LUDO MODELS

// PACMAN MODELS
model PacmanLevel {
    id  Int @id @default(autoincrement())
    name String
    map Json
    createdAt DateTime @default(now()) 
}

model PacmanScore {
    id  Int @id @default(autoincrement())
    playerName String
    score Int
    levelId Int
    createdAt DateTime @default(now()) 
}