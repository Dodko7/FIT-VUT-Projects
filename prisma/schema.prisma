// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
}

// LUDO MODELS

// Current game model (basically set when a match starts, cleared upon exiting or when it ends since then the entire match data is deleted)
model CurrentGame {
    id      Int   @id @default(autoincrement())
    game    Game  @relation(fields: [gameId], references: [id])
    gameId  Int   @unique
}

// Game model
model Game {
    id        Int       @id @default(autoincrement())
    name      String
    lastPlayed DateTime
    players   Player[]
    // This can be used as a turn tracker
    turn Color  @default(RED)
    // Has to be false by default (because web api...)
    musicOn   Boolean   @default(false)
    currentGame CurrentGame?
    // JSON loaded games - can be saved though on pause
    isTemp    Boolean   @default(false)
}

// Player model
model Player {
    id        Int       @id @default(autoincrement())
    name      String
    color     Color
    game      Game      @relation(fields: [gameId], references: [id])
    gameId    Int
    pawns     Pawn[]
    isBot     Boolean
    finished  Boolean   @default(false)
}

// Pawn model
model Pawn {
    id        Int       @id @default(autoincrement())
    position  Int
    player    Player    @relation(fields: [playerId], references: [id])
    playerId  Int
    inHome     Boolean   @default(false)
}

// Color enum
enum Color {
    RED
    BLUE
    GREEN
    YELLOW
}

// END OF LUDO MODELS