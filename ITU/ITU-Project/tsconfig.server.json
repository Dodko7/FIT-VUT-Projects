{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "isolatedModules": false,
    "noEmit": false,
    "esModuleInterop": true
  },
  "include": ["server.ts"],
  "exclude": [".next", "node_modules", "dist", "build"]
}
